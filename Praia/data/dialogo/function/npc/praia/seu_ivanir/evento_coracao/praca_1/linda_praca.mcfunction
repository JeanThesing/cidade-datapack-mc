tellraw @a[distance=..8] [{"color":"gold","text":"<Seu Ivanir>"},{"color":"white","text":" Tens total razão, meu jovem! Ainda mais acompanhado desta paradisíaca paisagem... Esta praça é, de longe, o melhor lugar daqui. Sabe, esta praça me lembra a cidade que cresci. Ângulo, se chamava, lindíssima cidade, passei praticamente toda minha vida lá. Vim para cá há pouco tempo."},{"bold":true,"click_event":{"action":"run_command","command":"function dialogo:npc/praia/seu_ivanir/evento_coracao/praca_1/historia_1a"},"color":"dark_green","text":"\n Por que veio para cá, senhor?"},{"bold":true,"click_event":{"action":"run_command","command":"/tellraw @a[distance=..10] {\"text\":\"(Seu Ivanir concorda balançando a cabeça e volta a apreciar a natureza)\",\"color\":\"white\",\"bold\":true}"},"color":"dark_green","text":"\n Que bom, senhor, a paisagem complementa ainda mais a beleza desta praça!"}]

playsound minecraft:block.note_block.bass voice @a[distance=..10] ~ ~ ~ 1 0.6